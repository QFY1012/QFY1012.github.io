---
import '../styles/tokens.css';
import '../styles/home.css';
---

<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>屈非塬 · HCI Researcher</title>
  <style>
    /* ── index 专有样式（新视觉语言：克制 · 深色唯一） ── */

    /* NAV：首屏隐藏；滚过首屏从顶部滑入 */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      backdrop-filter: blur(12px);
      transform: translateY(-110%);
      opacity: 0;
      transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.4s ease;
    }
    nav.is-visible { transform: translateY(0); opacity: 1; }
    /* 导航左侧：打字机（不显示姓名）；blink 关键帧复用 tokens.css */
    .logo { display: flex; align-items: center; gap: 2px; }
    /* 不设 min-width：光标必须紧跟最后一个字符 */
    .logo-tag {
      font-family: var(--font-mono);
      font-size: 13px; font-weight: 400; letter-spacing: 0.1em;
      color: var(--accent); text-transform: uppercase;
    }
    .logo-cur {
      display: inline-block; width: 2px; height: 1em;
      background: var(--accent);
      animation: blink 1s step-end infinite;
    }
    .nav-center { position: absolute; left: 50%; transform: translateX(-50%); }
    .nav-links { display: flex; list-style: none; }
    .nav-links a {
      color: var(--text-dim); text-decoration: none;
      font-size: var(--text-meta); letter-spacing: 0.09em; text-transform: uppercase;
      padding: 0.4rem 0.9rem;
      transition: color 0.18s;
      border-bottom: 1px solid transparent;
    }
    .nav-links a:hover { color: var(--text); border-bottom-color: var(--text-dimmer); }
    .nav-resume {
      font-family: var(--font-mono);
      font-size: var(--text-meta); letter-spacing: 0.08em;
      color: var(--text-dim); text-decoration: none;
      border: none; background: none;
      padding: 0.35rem 0;
      transition: color 0.18s;
    }
    .nav-resume:hover { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex; align-items: center;
    }
    /* 点染画面向下渐隐：55% 高度内全实，92% 处隐没 */
    #hero-ascii {
      -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
      mask-image: linear-gradient(180deg, #000 55%, transparent 92%);
    }
    .hero-inner {
      position: relative; z-index: 1;
      width: 100%; max-width: var(--content-w);
      margin: 0 auto; padding: 8rem 2.5rem 5rem;
    }
    .hero-copy {
      max-width: 620px;
      padding: 2rem; margin: -2rem;
      backdrop-filter: blur(1px);
      -webkit-backdrop-filter: blur(1px);
    }
    .hero-role {
      font-family: var(--font-mono);
      font-size: var(--text-meta); letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1.75rem;
    }
    .hero h1 { line-height: 1.1; }
    .hero h1 .en {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--text-meta); font-weight: 400; letter-spacing: 0.3em;
      color: var(--text-dimmer); margin-bottom: 0.9rem;
    }
    .hero h1 .zh {
      display: block;
      font-family: var(--font-body);
      font-size: var(--text-display);
      font-weight: 500; letter-spacing: 0.06em; color: var(--text);
    }
    .hero-desc { margin: 2.5rem 0 0; }
    .hero-desc p {
      font-size: var(--text-body); color: var(--text-dim); line-height: 2;
      max-width: 580px;
    }

    /* 滚动提示：底部中央，微标 + 细线内 accent 小段循环下落 */
    .scroll-cue {
      position: absolute; left: 0; right: 0; bottom: 2rem;
      width: fit-content; margin-inline: auto; /* 居中不能用 transform：会被 fu 动画的 transform:none 覆盖 */
      z-index: 1; /* 盖过 ::after 底部渐变 */
      display: flex; flex-direction: column; align-items: center; gap: 0.55rem;
      font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.3em;
      color: var(--text-dimmer);
    }
    .scroll-cue-line {
      width: 1px; height: 32px;
      background: var(--border-hi);
      position: relative; overflow: hidden;
    }
    .scroll-cue-line::after {
      content: ''; position: absolute; left: 0; top: -40%;
      width: 100%; height: 40%; background: var(--accent);
      animation: cue-drop 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
    @keyframes cue-drop { to { top: 110%; } }

    /* fade-up（keyframes fu 复用 tokens.css） */
    .fu { opacity: 0; transform: translateY(18px); animation: fu 0.65s ease forwards; }
    .fu-1 { animation-delay: 0.05s; }
    .fu-2 { animation-delay: 0.15s; }
    .fu-3 { animation-delay: 0.27s; }
    .fu-4 { animation-delay: 0.42s; }

    /* SECTION HEAD */
    .sec-head { margin-bottom: 2.75rem; }
    /* sec-head 三行字号保持原有比例，不随 token 缩放 */
    .sec-n { font-family: var(--font-mono); font-size: 10px; color: var(--text-dimmer); letter-spacing: 0.1em; margin-bottom: 0.3rem; }
    .sec-sub { font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.25rem; }
    h2 { font-family: var(--font-display); font-size: 24px; font-weight: 700; letter-spacing: -0.01em; line-height: 1; }

    /* SKILLS —— 无框，竖向发丝线分隔 */
    .skills-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
    }
    .skill-card { padding: 0 1.75rem; }
    .skill-card:first-child { padding-left: 0; }
    .skill-card + .skill-card { border-left: 1px solid var(--border); }
    .skill-card h3 { font-family: var(--font-body); font-size: var(--text-body); font-weight: 500; margin-bottom: 1rem; }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; }
    .tag {
      font-size: var(--text-meta);
      color: var(--text-dim);
      background: var(--chip);
      padding: 3px 10px;
    }

    /* TIMELINE */
    /* 左栏实习、右栏教育：硕士贴顶、本科贴右栏底部 */
    .timeline { display: grid; grid-template-columns: 3fr 2fr; gap: 3.5rem; align-items: stretch; }
    .exp-col { display: flex; flex-direction: column; }
    .exp-col .tl-item { border-bottom: none; }
    .exp-col:last-child { justify-content: space-between; }
    /* 时间线条目：单列，日期一行在上，内容对齐最左；无横向分割线 */
    .tl-item {
      display: grid; grid-template-columns: 1fr; gap: 0.4rem;
      padding: 1.75rem 0;
    }
    .tl-item:first-child { padding-top: 0; }
    .tl-item:last-child { padding-bottom: 0; }
    .tl-date { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--text-dimmer); letter-spacing: 0.04em; }
    /* 层级：学校 > 专业+学位 */
    .tl-content h3 { font-family: var(--font-body); font-size: var(--text-title); font-weight: 500; margin-bottom: 0.25rem; }
    .tl-major {
      font-size: var(--text-meta); color: var(--accent); margin-bottom: 0.6rem;
      display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;
    }
    .tl-content .company {
      font-size: var(--text-meta); color: var(--accent); margin-bottom: 0.6rem; letter-spacing: 0.04em;
      display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    }
    .tl-content p { font-size: var(--text-body); color: var(--text-dim); max-width: 66ch; }

    /* 实习子条目（无编号，领句 + 正文） */
    .xp-list { margin-top: 0.9rem; display: flex; flex-direction: column; gap: 0.9rem; }
    .xp-item strong { font-size: var(--text-body); font-weight: 500; color: var(--text); display: block; margin-bottom: 0.2rem; }
    .xp-item p { font-size: var(--text-body); line-height: 1.95; max-width: 66ch; margin: 0; }

    /* PROJECTS */
    .projects-grid { display: flex; flex-direction: column; }
    .pg-label {
      font-family: var(--font-mono);
      font-size: var(--text-meta); letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--text-dimmer); padding: 0.7rem 0;
      border-bottom: 1px solid var(--border); margin-top: 1.75rem;
      display: flex; justify-content: space-between; align-items: center;
    }
    .pg-label:first-child { margin-top: 0; padding-top: 0; }
    .project-card {
      border-bottom: 1px solid var(--border); padding: 1.6rem 0.75rem 1.6rem 0;
      display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: start;
      position: relative; transition: background 0.18s;
    }
    .project-card.clickable { cursor: pointer; }
    .project-card:hover { background: var(--hover); }
    /* 悬停箭头：右下角，与 WORKS 标题同字体同字号 */
    .project-arrow {
      position: absolute; right: 0.5rem; bottom: 1rem;
      color: var(--accent);
      font-family: var(--font-display); font-size: 24px;
      opacity: 0; transition: opacity 0.18s;
    }
    .project-card:hover .project-arrow { opacity: 1; }
    .ptitle-row { display: flex; align-items: flex-start; gap: 0.6rem; margin-bottom: 0.35rem; flex-wrap: wrap; }
    .project-card h3 { font-family: var(--font-body); font-size: var(--text-title); font-weight: 500; line-height: 1.4; }
    .project-sub { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--accent); margin-bottom: 0.65rem; letter-spacing: 0.03em; }
    .project-card p { font-size: var(--text-body); color: var(--text-dim); line-height: 1.85; max-width: 580px; }
    /* 右列撑满卡片高度：标签贴顶、链接贴底，消除右下留白 */
    .project-right {
      display: flex; flex-direction: column; align-items: flex-end;
      gap: 0.65rem; flex-shrink: 0; min-width: 110px;
      align-self: stretch; justify-content: space-between;
    }
    .project-links { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
    /* 链接 = 软底方片，无边框无圆角，彼此留出呼吸感 */
    .btn-link {
      font-family: var(--font-mono);
      font-size: var(--text-meta); padding: 4px 10px;
      border: none; background: var(--chip);
      color: var(--text-dim);
      text-decoration: none; transition: color 0.18s, background 0.18s;
      letter-spacing: 0.05em; white-space: nowrap;
    }
    .btn-link:hover { color: var(--text); background: var(--chip-hover); }
    /* 链接层级：详情为一级（高亮软底），其余为二级（常规软底） */
    .btn-link.detail { color: var(--accent); background: var(--chip-accent); font-weight: 500; }
    .btn-link.detail:hover { color: var(--accent-hi); }

    /* CONTACT —— 无框，竖向发丝线分隔 */
    .contact-grid {
      display: grid; grid-template-columns: repeat(3, 1fr);
    }
    .contact-card {
      padding: 0 1.75rem;
      text-decoration: none; color: var(--text);
    }
    .contact-card:first-child { padding-left: 0; }
    .contact-card + .contact-card { border-left: 1px solid var(--border); }
    .c-type { font-family: var(--font-mono); font-size: var(--text-meta); letter-spacing: 0.14em; color: var(--text-dimmer); text-transform: uppercase; margin-bottom: 0.5rem; }
    .c-value { font-size: var(--text-body); color: var(--text); transition: color 0.18s; }
    .contact-card:hover .c-value { color: var(--accent); }

    /* FOOTER */
    footer {
      max-width: var(--content-w); margin: 0 auto;
      padding: 1.75rem 2.5rem 4rem;
      border-top: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;
      font-size: var(--text-meta); color: var(--text-dimmer); letter-spacing: 0.07em;
    }
    footer a { color: var(--accent); text-decoration: none; }
    footer a:hover { text-decoration: underline; }

    /* ── 自适应：1024 / 860 / 768 / 640 / 480 五档 ── */
    @media (max-width: 1024px) {
      .hero-inner { padding-left: 2rem; padding-right: 2rem; }
      section { padding-left: 2rem; padding-right: 2rem; }
    }
    @media (max-width: 860px) {
      /* 两栏堆叠成一条流：grid 不再额外加 gap，条目间距全由 tl-item 的 padding 决定 */
      .timeline { grid-template-columns: 1fr; gap: 0; }
      .exp-col:last-child { justify-content: flex-start; } /* space-between 仅桌面双栏生效 */
      /* 堆叠后“每列首/末”≠“整体首/末”：补回被清零的 padding，保证三段经历间距一致 */
      .exp-col:first-child .tl-item:last-child { padding-bottom: 1.75rem; }
      .exp-col:last-child .tl-item:first-child { padding-top: 1.75rem; }
      .skills-grid, .contact-grid { grid-template-columns: 1fr; }
      .skill-card, .contact-card { padding: 1.2rem 0; }
      /* 各板块首个内容元素一律贴 sec-head：标题到内容的距离 = sec-head margin，处处相同 */
      .skill-card:first-child, .contact-card:first-child { padding-top: 0; }
      .skill-card + .skill-card, .contact-card + .contact-card { border-left: none; }
      .project-card { grid-template-columns: 1fr; padding-right: 0; }
      .project-right { align-items: flex-start; }
      .project-links { justify-content: flex-start; }
      .project-arrow { display: none; }
    }
    @media (max-width: 768px) {
      .nav-center { display: none; }           /* 中段锚点隐藏，导航只留 logo + 简历 */
    }
    @media (max-width: 640px) {
      nav { padding: 0.75rem 1.25rem; }
      .hero-inner { padding: 6.5rem 1.25rem 4rem; }
      .hero-copy { padding: 1.25rem; margin: -1.25rem; }
      section { padding: clamp(3rem, 7vw, 4rem) 1.25rem; }
      .tl-item { grid-template-columns: 1fr; gap: 0.3rem; }
      .pg-label { flex-wrap: wrap; gap: 0.5rem; }
      footer { padding: 1.5rem 1.25rem 3.5rem; flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 480px) {
      .hero-role { letter-spacing: 0.14em; }
    }
  </style>
</head>
<body>

  <!-- HERO -->
  <div class="hero">
    <canvas id="hero-ascii" aria-hidden="true"></canvas>
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-role fu fu-1">HCI Researcher · Designer · Developer</div>

        <h1 class="fu fu-2">
          <span class="en">QU FEIYUAN</span>
          <span class="zh">屈非塬</span>
        </h1>

        <div class="hero-desc fu fu-3">
          <p>浙江大学 CAD&amp;CG 全国重点实验室硕士研究生，研究方向为人机交互与智能可视化，专注于通过交互创新手段让 LLM 更好地完成数据分析与可视叙事任务（LLM4Vis · Agent4Vis · Chart Generation）</p>
        </div>
      </div>
    </div>
    <div class="scroll-cue fu fu-4" aria-hidden="true">
      <span>SCROLL</span>
      <span class="scroll-cue-line"></span>
    </div>
  </div>

  <!-- NAV：首屏之后出现，滚过首屏吸顶 -->
  <nav>
    <div class="logo">
      <span class="logo-tag" id="logo-tag"></span><span class="logo-cur"></span>
    </div>
    <div class="nav-center">
      <ul class="nav-links">
        <li><a href="#skills">skills</a></li>
        <li><a href="#education">edu</a></li>
        <li><a href="#projects">works</a></li>
        <li><a href="#contact">contact</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <a href="/resume.html" target="_blank" class="nav-resume">简历</a>
    </div>
  </nav>

  <!-- SKILLS -->
  <section id="skills">
    <div class="sec-head">
      <div class="sec-head-text">
        <div class="sec-n">01 /</div>
        <div class="sec-sub">专业技能</div>
        <h2>CAPABILITIES</h2>
      </div>
    </div>
    <div class="skills-grid">
      <div class="skill-card">
        <h3>设计</h3>
        <div class="tags">
          <span class="tag">原型设计</span>
          <span class="tag">Figma</span>
          <span class="tag">用户研究</span>
          <span class="tag">信息架构</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>开发</h3>
        <div class="tags">
          <span class="tag">Python</span>
          <span class="tag">React</span>
          <span class="tag">PydenticAgent</span>
          <span class="tag">LangGraph</span>
        </div>
      </div>
      <div class="skill-card">
        <h3>研究</h3>
        <div class="tags">
          <span class="tag">LLM4Vis</span>
          <span class="tag">Agent4Vis</span>
          <span class="tag">Chart Generation</span>
          <span class="tag">Paper Writing</span>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION & INTERNSHIP -->
  <section id="education">
    <div class="sec-head">
      <div class="sec-head-text">
        <div class="sec-n">02 /</div>
        <div class="sec-sub">教育 &amp; 实习</div>
        <h2>EXPERIENCE</h2>
      </div>
    </div>
    <div class="timeline">
      <div class="exp-col">
      <div class="tl-item">
        <div class="tl-date">2026.06 — 至今</div>
        <div class="tl-content">
          <h3>实习 AI 设计工程师（AI Design Engineering）</h3>
          <div class="company">阿里巴巴 · 淘天集团</div>
          <p>沿 Skill 与 Tool 两个维度扩展 Taobao Design Counselor 其能力边界。</p>
          <div class="xp-list">
            <div class="xp-item">
              <strong>Skill 入库标准制定与管理</strong>
              <p>设计师提交的 Skill 源码质量参差：内容堆成“屎山”，或滥用 LLM 执行无法验证的任务（如预测眼动）。主导制定 Skill 入库评价标准，按 Token 消耗、运行效率与执行稳定性评估；并搭建基于 LLM 的自动化修改流水线，将不达标 Skill 修订后入库</p>
            </div>
            <div class="xp-item">
              <strong>Skill 输出标准制定</strong>
              <p>Skill 产出的 HTML 页面视觉质量参差不齐，难达团队预期。主导制定 HTML 的设计规范（基于 Radix UI 搭建组件库、定义视觉规范与 design token），以 DOM + CV + LLM 多模态评测检查 Skill 输出质量（是否使用组件、间距是否满足要求、留白是否得当等），让 Agent 以 loop 方式改良其视觉输出</p>
            </div>
            <div class="xp-item">
              <strong>Agent PPT 制作模式设计与研发</strong>
              <p>为 Agent 提供多套 html PPT 模板，并配套在线 html 编辑器，支持手动调整或指定元素交由 Agent 修改</p>
            </div>
          </div>
        </div>
      </div>
      </div>
      <div class="exp-col">
      <div class="tl-item">
        <div class="tl-date">2024.09 — 至今</div>
        <div class="tl-content">
          <h3>浙江大学 · CAD&amp;CG 全国重点实验室</h3>
          <div class="tl-major">人机交互 · 工学硕士</div>
          <p>导师：巫英才　研究方向：LLM4Vis · Agent4Vis · Chart Generation</p>
        </div>
      </div>
      <div class="tl-item">
        <div class="tl-date">2020.09 — 2024.06</div>
        <div class="tl-content">
          <h3>湖南大学 · 设计学院</h3>
          <div class="tl-major">
            工业设计 · 工学学士
            <a href="/papers/gpa.pdf" target="_blank" class="btn-link">📄 成绩单</a>
          </div>
          <p>年级第一　主修课程：智能设计方法 · 人机交互设计</p>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects">
    <div class="sec-head">
      <div class="sec-head-text">
        <div class="sec-n">03 /</div>
        <div class="sec-sub">项目 &amp; 论文</div>
        <h2>WORKS</h2>
      </div>
    </div>
    <div class="projects-grid">

      <div class="pg-label">
        <span>研究生</span>
      </div>

      <div class="project-card clickable" data-href="/toa">
        <span class="project-arrow">→</span>
        <div>
          <div class="ptitle-row">
            <h3>ToA：对话式可视分析产品设计</h3>
          </div>
          <div class="project-sub">CHI'26 收录 · 第一作者 · 人机交互 CCF-A · 2025.07—2025.11</div>
          <p>新手在多轮可视分析对话中频繁"迷路"：线性界面难以回溯历史决策，认知负担持续积累。ToA 将分析对话重组为可分支、可回溯的"分析树"，让用户随时定位当前位置、自由切换探索路径。系统基于 LangChain 编排 LLM Workflow，每轮问答生成数据分析图表，并将结果作为节点插入分析树。对照实验（N=12）表明：洞察数量增加 58.3%，深度思考时间增加 17%</p>
