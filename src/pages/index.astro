---
import '../styles/tokens.css';
---

<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>屈非塬 · HCI Researcher</title>
  <script>document.documentElement.setAttribute('data-theme',localStorage.getItem('theme')||'dark')</script>
  <style>
    /* ── index 专有：tokens.css 中没有的部分 ── */

    /* accent3 (仅 index 用到) */
    :root { --accent3: #ff6b8a; }
    [data-theme="light"] { --accent3: #cc2244; }

    /* NAV logo */
    .logo {
      font-family: var(--font-display);
      font-weight: 800; font-size: 1.05rem; letter-spacing: 0.06em;
      display: flex; align-items: center; gap: 0.4rem;
    }
    .logo-b { color: var(--accent); opacity: 0.55; }
    .logo-tag {
      font-size: 0.72rem; font-weight: 400; letter-spacing: 0.06em;
      color: var(--accent2); margin-left: 0.5rem;
      font-family: var(--font-mono);
    }
    .logo-cur {
      display: inline-block; width: 2px; height: 0.95em;
      background: var(--accent2);
      animation: blink 1s step-end infinite;
      vertical-align: middle; margin-left: 1px;
    }

    nav { justify-content: space-between; }
    .nav-center { position: absolute; left: 50%; transform: translateX(-50%); }
    .nav-right { display: flex; align-items: center; gap: 0.25rem; }
    .nav-links { display: flex; list-style: none; }
    .nav-links a {
      color: var(--text-dim); text-decoration: none;
      font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase;
      padding: 0.4rem 0.9rem;
      border: 1px solid transparent;
      transition: color 0.2s, border-color 0.2s, background 0.2s;
    }
    .nav-links a:hover { color: var(--accent2); border-color: var(--border); background: var(--glow-b); }

    .theme-toggle { display: flex; gap: 5px; align-items: center; margin-left: 0.75rem; }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex; flex-direction: column; justify-content: center;
      padding: 8rem 2.5rem 5rem;
      max-width: 960px; margin: 0 auto;
    }
    .hero-eyebrow {
      display: flex; align-items: center; gap: 0.75rem;
      margin-bottom: 1.75rem;
      font-size: 0.68rem; color: var(--text-dimmer); letter-spacing: 0.12em;
    }
    .hero-eyebrow .dash { width: 36px; height: 1px; background: var(--border-hi); }
    .hero-eyebrow-tag { color: var(--accent2); }
    .hero-role {
      font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--accent); margin-bottom: 1.5rem;
    }
    .hero-role::before { content: '> '; }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 8vw, 6rem);
      font-weight: 700; line-height: 1.05; letter-spacing: -0.02em;
    }
    .hero h1 .en {
      display: block;
      font-size: clamp(1.1rem, 2.8vw, 1.8rem);
      font-family: var(--font-display);
      font-weight: 400; letter-spacing: 0.18em;
      color: var(--text-dim); margin-bottom: 0.6rem;
    }
    .hero h1 .zh { position: relative; display: inline-block; color: var(--text); letter-spacing: 0.15em; }
    .hero h1 .zh::after {
      content: ''; position: absolute; bottom: 2px; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      transform: scaleX(0); transform-origin: left;
      animation: uline 0.8s 0.6s ease forwards;
    }
    @keyframes uline { to { transform: scaleX(1); } }

    .hero-desc { margin: 2.5rem 0 3rem; max-width: 580px; }
    .hero-desc .prompt { font-size: 0.72rem; color: var(--accent); margin-bottom: 0.4rem; }
    .hero-desc p {
      font-size: 0.94rem; color: var(--text-dim); line-height: 1.95;
      border-left: 2px solid var(--border-hi); padding-left: 1rem;
    }

    .cta-group { display: flex; gap: 0.875rem; flex-wrap: wrap; }
    .btn {
      font-family: var(--font-mono);
      font-size: 0.76rem; letter-spacing: 0.07em;
      padding: 0.6rem 1.4rem; text-decoration: none;
      border: 1px solid transparent; cursor: crosshair;
      transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.4rem;
    }
    .btn-primary {
      color: var(--accent2); border-color: var(--accent2);
      position: relative; overflow: hidden;
    }
    .btn-primary::before {
      content: ''; position: absolute; inset: 0;
      background: var(--accent2); transform: translateX(-100%);
      transition: transform 0.22s ease; z-index: -1;
    }
    .btn-primary:hover::before { transform: translateX(0); }
    .btn-primary:hover { color: var(--bg); }
    .btn-ghost { color: var(--text-dim); border-color: var(--border-hi); }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

    /* fade-up */
    .fu { opacity: 0; transform: translateY(18px); animation: fu 0.65s ease forwards; }
    @keyframes fu { to { opacity: 1; transform: translateY(0); } }
    .fu-1 { animation-delay: 0.05s; }
    .fu-2 { animation-delay: 0.15s; }
    .fu-3 { animation-delay: 0.27s; }
    .fu-4 { animation-delay: 0.42s; }
    .fu-5 { animation-delay: 0.57s; }

    /* SECTIONS */
    section { max-width: 960px; margin: 0 auto; padding: 5rem 2.5rem; }
    section + section { border-top: 1px solid var(--border); }
    .sec-head { display: flex; align-items: flex-end; gap: 1.5rem; margin-bottom: 2.75rem; }
    .sec-head-text { flex-shrink: 0; }
    .sec-n { font-size: 0.65rem; color: var(--text-dimmer); letter-spacing: 0.1em; margin-bottom: 0.2rem; }
    .sec-sub { font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.2rem; }
    h2 { font-family: var(--font-display); font-size: 1.65rem; font-weight: 700; letter-spacing: -0.01em; line-height: 1; }
    .sec-line { flex: 1; height: 1px; background: linear-gradient(90deg, var(--border-hi), transparent); margin-bottom: 0.4rem; }

    /* SKILLS */
    .skills-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1px; border: 1px solid var(--border); background: var(--border);
    }
    .skill-card {
      background: var(--surface); padding: 1.4rem;
      transition: background 0.2s; position: relative; overflow: hidden;
    }
    .skill-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--accent), transparent);
      transform: scaleX(0); transform-origin: left; transition: transform 0.3s;
    }
    .skill-card:hover { background: var(--surface2); }
    .skill-card:hover::before { transform: scaleX(1); }
    .skill-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.9rem; }
    .skill-card h3 { font-size: 0.69rem; color: var(--accent2); letter-spacing: 0.14em; text-transform: uppercase; }
    .skill-idx { font-size: 0.6rem; color: var(--text-dimmer); }
    .tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .tag {
      font-size: 0.69rem; padding: 3px 8px;
      border: 1px solid var(--border-hi); color: var(--text-dim);
      transition: all 0.2s;
    }
    .tag:hover { border-color: var(--accent2); color: var(--accent2); }

    /* TIMELINE */
    .timeline { display: flex; flex-direction: column; }
    .tl-item {
      display: grid; grid-template-columns: 155px 1fr; gap: 2rem;
      padding: 1.75rem 0; border-bottom: 1px solid var(--border);
    }
    .tl-item:last-child { border-bottom: none; }
    .tl-date { font-size: 0.69rem; color: var(--text-dimmer); padding-top: 3px; letter-spacing: 0.04em; }
    .tl-content h3 { font-family: var(--font-display); font-size: 0.98rem; font-weight: 700; margin-bottom: 0.2rem; }
    .tl-content .company {
      font-size: 0.75rem; color: var(--accent); margin-bottom: 0.6rem; letter-spacing: 0.04em;
      display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
    }
    .tl-content p { font-size: 0.86rem; color: var(--text-dim); }

    /* PROJECTS */
    .projects-grid { display: flex; flex-direction: column; }
    .pg-label {
      font-size: 0.65rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--text-dimmer); padding: 0.7rem 0;
      border-bottom: 1px solid var(--border); margin-top: 1.75rem;
      display: flex; justify-content: space-between; align-items: center;
    }
    .pg-label:first-child { margin-top: 0; }
    .pg-label-left::before { content: '# '; color: var(--accent); }
    .project-card {
      border-bottom: 1px solid var(--border); padding: 1.6rem 0;
      display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: start;
      position: relative; transition: padding-left 0.2s, background 0.2s;
      cursor: crosshair;
    }
    .project-card::before {
      content: ''; position: absolute; left: -2.5rem; top: 0; bottom: 0; width: 2px;
      background: linear-gradient(180deg, var(--accent), var(--accent2));
      transform: scaleY(0); transform-origin: top; transition: transform 0.28s ease;
    }
    .project-card:hover::before { transform: scaleY(1); }
    .project-card:hover { background: rgba(98,114,255,0.025); padding-left: 0.6rem; }
    .ptitle-row { display: flex; align-items: flex-start; gap: 0.6rem; margin-bottom: 0.35rem; flex-wrap: wrap; }
    .project-card h3 { font-family: var(--font-display); font-size: 0.97rem; font-weight: 700; line-height: 1.4; }
    .project-badge {
      font-size: 0.62rem; padding: 2px 7px;
      border: 1px solid var(--accent); color: var(--accent);
      white-space: nowrap; letter-spacing: 0.07em; flex-shrink: 0; margin-top: 3px;
    }
    .project-sub { font-size: 0.72rem; color: var(--accent2); margin-bottom: 0.65rem; letter-spacing: 0.03em; }
    .project-card p { font-size: 0.86rem; color: var(--text-dim); line-height: 1.85; max-width: 580px; }
    .project-right {
      display: flex; flex-direction: column; align-items: flex-end;
      gap: 0.65rem; flex-shrink: 0; min-width: 110px;
    }
    .project-tags { display: flex; flex-wrap: wrap; gap: 4px; justify-content: flex-end; }
    .project-links { display: flex; flex-wrap: wrap; gap: 5px; justify-content: flex-end; }
    .btn-link {
      font-size: 0.66rem; padding: 3px 9px;
      border: 1px solid var(--border-hi); color: var(--text-dim);
      text-decoration: none; transition: all 0.2s; letter-spacing: 0.05em; white-space: nowrap;
    }
    .btn-link:hover { border-color: var(--accent); color: var(--accent); }
    .btn-link.detail { border-color: rgba(98,114,255,0.4); color: var(--accent); }
    .btn-link.detail:hover { background: rgba(98,114,255,0.1); }
    .btn-link.paper { border-color: rgba(98,114,255,0.4); color: var(--accent); }
    .btn-link.paper:hover { background: rgba(98,114,255,0.1); }
    .btn-link.video { border-color: rgba(0,232,200,0.4); color: var(--accent2); }
    .btn-link.video:hover { background: rgba(0,232,200,0.07); }

    /* CONTACT */
    .contact-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(195px, 1fr));
      gap: 1px; border: 1px solid var(--border); background: var(--border);
    }
    .contact-card {
      background: var(--surface); padding: 1.4rem;
      text-decoration: none; color: var(--text);
      transition: background 0.2s; position: relative; overflow: hidden;
    }
    .contact-card::after {
      content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, var(--accent2), var(--accent));
      transform: scaleX(0); transform-origin: left; transition: transform 0.3s;
    }
    .contact-card:hover { background: var(--surface2); }
    .contact-card:hover::after { transform: scaleX(1); }
    .c-type { font-size: 0.62rem; letter-spacing: 0.15em; color: var(--text-dimmer); text-transform: uppercase; margin-bottom: 0.45rem; }
    .c-label { font-size: 0.7rem; color: var(--text-dim); margin-bottom: 0.2rem; }
    .c-value { font-size: 0.85rem; color: var(--text); }

    /* FOOTER */
    footer {
      max-width: 960px; margin: 0 auto;
      padding: 1.75rem 2.5rem 5rem;
      border-top: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;
      font-size: 0.65rem; color: var(--text-dimmer); letter-spacing: 0.07em;
    }
    footer a { color: var(--accent); text-decoration: none; }
    footer a:hover { text-decoration: underline; }

    @media (max-width: 680px) {
      nav { padding: 0.75rem 1.25rem; }
      .nav-center { display: none; }
      .nav-links a { padding: 0.35rem 0.55rem; font-size: 0.66rem; }
      .hero { padding: 6.5rem 1.25rem 4rem; }
      section { padding: 3.5rem 1.25rem; }
      .tl-item { grid-template-columns: 1fr; gap: 0.2rem; }
      .project-card { grid-template-columns: 1fr; }
      .project-right { align-items: flex-start; }
      .project-tags, .project-links { justify-content: flex-start; }
      .status-bar { padding: 0.28rem 1.25rem; }
      footer { padding: 1.5rem 1.25rem 4.5rem; flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>

  <!-- NAV -->
  <nav>
    <div class="logo">
      <span>屈非塬</span>
      <span class="logo-tag" id="logo-tag"></span>
      <span class="logo-cur"></span>
    </div>
    <div class="nav-center">
      <ul class="nav-links">
        <li><a href="#skills">skills</a></li>
        <li><a href="#education">edu</a></li>
        <li><a href="#projects">works</a></li>
        <li><a href="#contact">contact</a></li>
      </ul>
    </div>
    <div class="nav-right">
      <div class="theme-toggle">
        <div class="theme-dot dark" data-t="dark" title="暗色"></div>
        <div class="theme-dot light" data-t="light" title="亮色"></div>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <div class="hero">

    <div class="hero-role fu fu-1">HCI Researcher · Designer · Developer</div>

    <h1 class="fu fu-2">
      <span class="en">QU FEIYUAN</span>
      <span class="zh">屈非塬</span>
    </h1>

    <div class="hero-desc fu fu-3">
      <p>浙江大学 CAD&amp;CG 全国重点实验室硕士研究生，研究方向为人机交互与智能可视化，专注于通过交互创新手段让 LLM 更好地完成数据分析与可视叙事任务（LLM4Vis · Agent4Vis · Chart Generation）</p>
    </div>

    <div class="cta-group fu fu-4">
      <a href="#projects" class="btn btn-primary">→ 查看项目</a>
      <a href="mailto:feiyuan_qu@zju.edu.cn" class="btn btn-ghost">联系我</a>
    </div>
  </div>

  <!-- SKILLS -->
  <section id="skills">
    <div class="sec-head">
      <div class="sec-head-text">
        <div class="sec-n">01 /</div>
        <div class="sec-sub">专业技能</div>
        <h2>CAPABILITIES</h2>
      </div>
      <div class="sec-line"></div>
    </div>
    <div class="skills-grid">
      <div class="skill-card">
        <div class="skill-head">
          <h3>设计</h3>
          <span class="skill-idx">[0x01]</span>
        </div>
        <div class="tags">
          <span class="tag">原型设计</span>
          <span class="tag">Figma</span>
          <span class="tag">用户研究</span>
          <span class="tag">信息架构</span>
        </div>
      </div>
      <div class="skill-card">
        <div class="skill-head">
          <h3>开发</h3>
          <span class="skill-idx">[0x02]</span>
        </div>
        <div class="tags">
          <span class="tag">Python</span>
          <span class="tag">React</span>
          <span class="tag">LangChain</span>
          <span class="tag">LangGraph</span>
        </div>
      </div>
      <div class="skill-card">
        <div class="skill-head">
          <h3>研究</h3>
          <span class="skill-idx">[0x03]</span>
        </div>
        <div class="tags">
          <span class="tag">LLM4Vis</span>
          <span class="tag">Agent4Vis</span>
          <span class="tag">Chart Generation</span>
          <span class="tag">Paper Writing</span>
        </div>
      </div>
    </div>
  </section>

  <!-- EDUCATION -->
  <section id="education">
    <div class="sec-head">
      <div class="sec-head-text">
        <div class="sec-n">02 /</div>
        <div class="sec-sub">教育经历</div>
        <h2>EDUCATION</h2>
      </div>
      <div class="sec-line"></div>
    </div>
    <div class="timeline">
      <div class="tl-item">
        <div class="tl-date">2024.09 — 至今</div>
        <div class="tl-content">
          <h3>工学硕士 · 人机交互</h3>
          <div class="company">浙江大学 · CAD&amp;CG 全国重点实验室</div>
          <p>导师：巫英才　研究方向：LLM4Vis · Agent4Vis · Chart Generation</p>
        </div>
      </div>
      <div class="tl-item">
        <div class="tl-date">2020.09 — 2024.06</div>
        <div class="tl-content">
          <h3>工学学士 · 工业设计</h3>
          <div class="company">
            湖南大学
            <a href="/papers/gpa.pdf" target="_blank" class="btn-link paper" style="font-size:0.65rem;padding:2px 7px">📄 成绩单</a>
          </div>
          <p>年级第一　主修课程：智能设计方法 · 人机交互设计</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects">
    <div class="sec-head">
      <div class="sec-head-text">
        <div class="sec-n">03 /</div>
        <div class="sec-sub">项目 &amp; 论文</div>
        <h2>WORKS</h2>
      </div>
      <div class="sec-line"></div>
    </div>
    <div class="projects-grid">

      <div class="pg-label">
        <span class="pg-label-left">研究生</span>
      </div>

      <div class="project-card clickable" data-href="/toa">
        <div>
          <div class="ptitle-row">
            <h3>ToA：对话式可视分析产品设计</h3>
            <span class="project-badge">独立一作</span>
          </div>
          <div class="project-sub">CHI'26 · 人机交互 CCF-A · Accepted · 2025.07—2025.11</div>
          <p>新手在多轮可视分析对话中频繁"迷路"：线性界面难以回溯历史决策，认知负担持续积累。ToA 将分析对话重组为可分支、可回溯的"分析树"，让用户随时定位当前位置、自由切换探索路径。系统基于 LangChain 编排 LLM Workflow，每轮问答生成数据分析图表，并将结果作为节点插入分析树。对照实验（N=12）表明：洞察数量增加 58.3%，深度思考时间增加 17%</p>
        </div>
        <div class="project-right">
          <div class="project-tags">
            <span class="tag">LangChain</span>
            <span class="tag">LLM</span>
            <span class="tag">可视化</span>
          </div>
          <div class="project-links">
            <a href="/toa" class="btn-link detail">详情</a>
            <a href="/papers/toa-chi26.pdf" target="_blank" class="btn-link paper">📄 Paper</a>
            <a href="/papers/CHI-Presentation.pptx" download class="btn-link">🗂 Slides</a>
            <a href="/videos/toa-demo.mp4" target="_blank" class="btn-link video">▶ Video</a>
          </div>
        </div>
      </div>

      <div class="project-card clickable" data-href="/narrasteer">
        <div>
          <div class="ptitle-row">
            <h3>NarraSteer：面向数据叙事的 Agent 交互产品设计</h3>
            <span class="project-badge">独立一作</span>
          </div>
          <div class="project-sub">UIST'26 · 人机交互 CCF-A · Under Review · 2026.01—2026.04</div>
          <p>LLM Agent 执行数据叙事任务时，中间步骤杂乱无序、过程不透明，用户只能被动等待结果。NarraSteer 将 Agent 的执行过程重组为可拖拽的故事线，让用户得以实时介入、主动调整叙事方向。系统基于 LangGraph 构建 ReAct Agent，依据用户叙事工作流重新设计 Tool，并将每步 Reasoning-Acting 轨迹映射为可拖拽的叙事节点。对照实验（N=16）表明：洞察密度提升 13%，心理负荷显著下降（p&lt;.05），感知可控性显著提升（p&lt;.05）</p>
        </div>
        <div class="project-right">
          <div class="project-tags">
            <span class="tag">LangGraph</span>
            <span class="tag">Agent</span>
            <span class="tag">数据叙事</span>
          </div>
          <div class="project-links">
            <a href="/narrasteer" class="btn-link detail">详情</a>
            <a href="/papers/narrasteer-uist26.pdf" target="_blank" class="btn-link paper">📄 Paper</a>
            <a href="/videos/narrasteer-demo.mp4" target="_blank" class="btn-link video">▶ Video</a>
          </div>
        </div>
      </div>

      <div class="project-card">
        <div>
          <div class="ptitle-row">
            <h3>跨社交媒体舆情分析与治理平台</h3>
            <span class="project-badge">设计</span>
