---
import '../styles/tokens.css';
import '../styles/home.css'; // 与主页统一 token
import icPlay from 'lucide-static/icons/play.svg?raw';
import icDown from 'lucide-static/icons/arrow-down.svg?raw';
// 配图由 figures/internship/ 的脚本生成,node figures/internship/export.mjs 导出成下面这些片段
import figBefore from '../figures/internship/bg-before.html?raw';
import figSplit from '../figures/internship/bg-split.html?raw';
import figSkill from '../figures/internship/skill-flow.html?raw';
import figOutput from '../figures/internship/output-flow.html?raw';

// 公开复现里「交互流程挖掘」这个 Skill 的 13 轮 UI Spec 候选(experiments/ui-loop/skills/flow/state.json)
const rounds = [
  { n: 1, what: '核心指标一行排满，不再「3 + 1」折行', result: 'ok' },
  { n: 2, what: '链路明细一个产品一组，截图、标签、说明按步骤对齐', result: 'ok' },
  { n: 3, what: '步骤备注收进链路明细末尾，按产品分段', result: 'no' },
  { n: 4, what: '结论与核心指标合成首屏，背景信息并进「下一步」', result: 'no' },
  { n: 5, what: '步骤备注单独成表，一步一行', result: 'no' },
  { n: 6, what: '步骤备注贴在每组截图下方', result: 'no' },
  { n: 7, what: '背景信息移到结论之后', result: 'no' },
  { n: 8, what: '背景信息并进结论一节', result: 'no' },
  { n: 9, what: '步骤备注紧跟链路明细，与问题表对齐', result: 'no' },
  { n: 10, what: '背景信息提到页头之后，单独成节', result: 'ok' },
  { n: 11, what: '元信息并入页头，结论与指标同节', result: 'no' },
  { n: 12, what: '元信息并入封面，问题与建议合成一节', result: 'no' },
  { n: 13, what: '剩下的问题要靠新组件解决，这一轮作废，先交给组件 Reviser', result: 'void' },
];
const resultText = { ok: '采用', no: '未采用', void: '作废' };

// 审美 Judge 的 7 条 rubric(rubric31)
const criteria = ['留白合适', '分组清楚、有垂直韵律', '容器样式有功能', '字体层级清楚', '色彩统一', '同类组件一致', '网格对齐'];
// 示意的版本演进(experiments/ui-loop/demo):同一份报告按 loop 的规则排出的 9 个采用版本和 4 个被拒候选,
// 截图由组件库真实渲染,裁出这一版改动的那一节(public/images/internship/versions/)
const stages = [
  { no: '01', name: '无组件库', who: '模型直接写页面', items: ['v1'] },
  { no: '02', name: '组件库 + UI Spec', who: '生成 Agent 只能拼组件', items: ['v2'] },
  { no: '03', name: '组件迭代', who: '组件 Reviser · 人工审批', items: ['v3', 'v4'] },
  { no: '04', name: '审美迭代', who: 'UI Spec Reviser · 验证把关', items: ['v5', 'v6', 'v7', 'v8', 'v9'] },
];
const shot = (img, w, h) => ({ src: `/images/internship/versions/${img}.webp`, w, h });
const V = {
  v1: { title: '模型自己写', text: '只给数据，不给组件库：版式、颜色、卡片、字号都由模型当场决定。看着像样，但换一次生成就换一种风格。', facts: '9 种字号 · 27 个颜色类名 · 19 处圆角卡片', img: shot('free', 1000, 946) },
  v2: { title: '只用组件库写', text: '字号、颜色、间距、表格线都由组件给出，页面只决定用哪个组件、放在哪。但组件库里还没有放截图的组件，链路明细只剩文字。', facts: '程序检查 0 个问题 · 页面不写任何颜色和字号', img: shot('noimg', 1000, 513) },
  v3: { title: '新增截图组件', text: 'Maintainer 归因为「组件不够」。组件 Reviser 新增 FigureStrip 等截图部件，人工提了 3 次意见（改横向滚动、换滚动条、加宽间距），第 4 版合并。', img: shot('g0', 1000, 609) },
  v4: { title: '修现有组件', text: '进度条改成 1px 细线，截图下的滚动条只在悬停时出现；新增带标签的分组线，两条链路成为同一节里的两组。', img: shot('g1', 1000, 865) },
  v5: { title: '核心指标排成一行', text: '4 个数字一行排满，「发现问题」不再单独掉到第二行。', img: shot('g2', 1000, 125),
        branch: { title: '下一步改成表格', result: '没效果', why: '两种顺序判得相反：一次说表格便于比较，一次说像又一张明细表，和问题表分不开。', img: shot('c3', 1000, 151) } },
  v6: { title: '下一步按条数分列', text: '列数等于建议条数，两条建议各占半行，右边不再空出一列。', img: shot('g3', 1000, 115),
        branch: { title: '截图下删掉备注', result: '失败', why: '截图下方整齐了，但程序检查变差：页面缺了 5 项数据（每一步的问题备注）。', img: shot('c5', 1000, 609) } },
  v7: { title: '截图说明固定三行', text: '每张截图下固定三行：屏名、内容与操作、问题；没有问题就写「问题：无」。一排高度一致，备注也保留下来。', img: shot('g4', 1000, 609),
        branch: { title: '结论改成大数字', result: '失败', why: '在验证页上输了：「少 1 屏」的大数字让结论像又一组指标，优惠券的差别反而挤进小字。', img: shot('c7', 1000, 125) } },
  v8: { title: '结论分主次', text: '结论的判断句用大字，解释换行用正文：先读到结论，再读原因。', img: shot('g5', 1000, 125),
        branch: { title: '问题表改成列表', result: '没效果', why: '一次说列表好读，一次说严重度埋进说明里没法竖着比，「高」也不再标红。', img: shot('c9', 1000, 272) } },
  v9: { title: '问题表合成四列', text: '编号并进问题，产品和步骤并成「位置」：问题、位置、严重度、证据四列。审美 Judge 不再提出两种顺序都认可的问题，迭代结束。', img: shot('g6', 1000, 183) },
};
---
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>自迭代的中台设计 Agent · 屈非塬</title>
  <!-- 深色模式暂时隐藏：固定浅色，与其他项目页一致 -->
  <script is:inline>document.documentElement.setAttribute('data-theme','light')</script>
  <style>
    /* ── 实习项目页专有样式（字号/颜色全部取自 tokens + home 统一层）── */
    :global(html) { scroll-snap-type: none !important; }
    .hero { padding: 8rem 2.5rem 3rem; max-width: var(--content-w); margin: 0 auto; }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 4.5vw, 3rem);
      font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 1rem;
      text-wrap: balance;
    }
    .hero h1 .highlight { color: var(--accent); }
    .hero .subtitle { font-size: var(--text-body); color: var(--text-dim); margin-bottom: 0.4rem; }
    .hero .authors { font-size: var(--text-meta); color: var(--text-dimmer); margin-bottom: 2rem; letter-spacing: 0.03em; }
    .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .hero .result-grid { margin-top: 2.5rem; }
    .metric { font-variant-numeric: tabular-nums; }

    /* 配图：内嵌 SVG，与页面同底色，不加框 */
    .fig { margin-top: 2rem; }
    .fig + .img-caption { margin-top: 0.75rem; }

    /* 编号步骤 */
    .steps { counter-reset: none; }

    /* 两栏要点（无框） */
    .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 1.5rem; }
    .pair > div { min-width: 0; }
    .pair h3 { margin-bottom: 0.5rem; }
    @media (max-width: 700px) { .pair { grid-template-columns: 1fr; gap: 1.75rem; } }

    /* 小节标题（节内） */
    .sub-h { margin-top: 2.75rem; margin-bottom: 0.75rem; }

    /* 审美 rubric：7 条编号行 */
    .criteria { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.5rem 2rem; margin: 1rem 0 0.5rem; }
    .criteria li { display: flex; gap: 0.6rem; align-items: baseline; font-size: var(--text-body); color: var(--text); padding: 0.45rem 0; border-bottom: 1px solid var(--border); }
    .criteria .no { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--accent); font-variant-numeric: tabular-nums; }

    /* 公开复现的说明条 */
    .note {
      font-size: var(--text-meta); color: var(--text-dim); line-height: 1.8;
      border-left: 2px solid var(--accent); padding-left: 0.75rem; margin: 1rem 0 0;
    }

    /* 版本轨道：主线是采用的版本，没采用的候选从它出发的版本向右分出去 */
    .vtrack-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 1.5rem; font-size: var(--text-meta); color: var(--text-dim); }
    .vtrack-legend span { display: inline-flex; align-items: center; gap: 0.5rem; }
    .lg-main { width: 22px; border-top: 1.6px solid var(--accent); }
    .lg-branch { width: 22px; border-top: 1.4px dashed var(--text-dimmer); }
    .vtrack { margin-top: 1.25rem; }
    .vstage, .vrow { display: grid; grid-template-columns: 28px minmax(0, 1fr) minmax(0, 0.8fr); column-gap: 2.25rem; }
    .vrail { position: relative; }
    .vrail::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1.6px solid var(--accent); transform: translateX(-50%); }
    .vstage:first-child .vrail::before { top: 1.1rem; }
    .vrow.last .vrail::before { bottom: auto; height: 2rem; }
    .vstage > .vstage-h { margin-top: 2rem; }
    .vstage:first-child > .vstage-h { margin-top: 0; }
    .vstage .dot { position: absolute; left: 50%; top: 2.55rem; width: 13px; height: 13px; border-radius: 50%; transform: translateX(-50%); background: var(--bg); border: 1.6px solid var(--accent); }
    .vstage:first-child .dot { top: 0.55rem; }
    .vstage-h { grid-column: 2 / 4; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.9rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); }
    .vstage-no { font-family: var(--font-mono); font-size: var(--text-meta); letter-spacing: 0.12em; color: var(--accent); }
    .vstage-name { font-size: var(--text-title); font-weight: 700; color: var(--text); }
    .vstage-who { font-size: var(--text-meta); color: var(--text-dim); }
    .vrow > .vcard { padding-top: 1.5rem; }
    .vrow .dot { position: absolute; left: 50%; top: 1.95rem; width: 9px; height: 9px; border-radius: 50%; transform: translateX(-50%); background: var(--accent); }
    .vcard { min-width: 0; display: flex; flex-direction: column; gap: 0.35rem; }
    .vhead { display: flex; align-items: baseline; gap: 0.6rem; }
    .vno { font-family: var(--font-mono); font-size: var(--text-meta); font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums; }
    .vok { font-size: var(--text-meta); color: var(--accent); }
    .vcard h4 { font-size: var(--text-body); font-weight: 700; color: var(--text); }
    .vcard p { font-size: var(--text-meta); line-height: 1.8; margin: 0; }
    .vcard .facts { color: var(--text); }
    .vimg { margin-top: 0.4rem; border: 1px solid var(--border); background: #fff; overflow: hidden; }
    .vimg img { display: block; width: 100%; height: auto; }
    .vimg.tall { max-height: 340px; overflow-y: auto; overscroll-behavior: contain; }
    .vbranch { position: relative; }
    .vbranch::before { content: ''; position: absolute; right: calc(100% + 0.35rem); top: 2.12rem; width: 2.25rem; border-top: 1.4px dashed var(--text-dimmer); }
    .vbranch .vno, .vbranch .vx { color: var(--text-dimmer); }
    .vx { font-size: var(--text-meta); }
    .vbranch h4 { color: var(--text-dim); }
    .vbranch .vimg { opacity: 0.72; filter: grayscale(0.35); }
    .vrow:hover .vbranch .vimg { opacity: 1; filter: none; }
    @media (max-width: 860px) {
      .vstage, .vrow { grid-template-columns: 22px minmax(0, 1fr); column-gap: 1rem; }
      .vstage-h { grid-column: 2; }
      .vrow > .vbranch { grid-column: 2; margin: 1rem 0 0 1rem; padding: 0 0 0 1rem; border-left: 1.4px dashed var(--text-dimmer); }
      .vbranch::before { display: none; }
      .vimg.tall { max-height: 260px; }
    }

    /* 轮次表 */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 1.25rem; }
    .rounds { width: 100%; border-collapse: collapse; font-size: var(--text-body); }
    .rounds th {
      text-align: left; padding: 0.5rem 0.75rem; color: var(--accent);
      font-size: var(--text-meta); letter-spacing: 0.1em; font-weight: 500;
      border-bottom: 1px solid var(--border);
    }
    .rounds td { padding: 0.55rem 0.75rem; color: var(--text-dim); border-bottom: 1px solid var(--border); vertical-align: top; }
    .rounds tr:last-child td { border-bottom: none; }
    .rounds .n { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--text-dimmer); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .rounds .r { white-space: nowrap; font-size: var(--text-meta); }
    .rounds tr.ok td { color: var(--text); }
    .rounds tr.ok .r { color: var(--accent); font-weight: 700; }
    .rounds tr.void .r { color: var(--text-dimmer); }

    @media (max-width: 600px) { .hero { padding: 6.5rem 1.25rem 2.5rem; } }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="back-link">← 返回首页</a>
    <div class="nav-right">
      <span class="nav-badge">阿里巴巴 · 淘天集团</span>
      <div class="theme-dots" role="group" aria-label="切换明暗主题">
        <button class="theme-dot" type="button" data-set-theme="dark" aria-label="深色主题"></button>
        <button class="theme-dot" type="button" data-set-theme="light" aria-label="浅色主题"></button>
      </div>
    </div>
  </nav>

  <div class="hero">
    <span class="conf-badge">实习项目 · AI 设计工程师 · 2026.06 — 2026.09</span>
    <h1>自迭代的<span class="highlight">中台设计 Agent</span>：<br />框架设计与实践</h1>
    <div class="subtitle">设计 Agent 的 Skill 评测与 UI 输出自进化 · Taobao Design Counselor</div>
    <div class="authors">屈非塬 · 阿里巴巴淘天集团</div>
    <div class="hero-actions">
      <a href="/videos/showreel.mp4" target="_blank" class="btn-link video"><Fragment set:html={icPlay} /> Showreel</a>
      <a href="#reproduce" class="btn-link"><Fragment set:html={icDown} /> 公开复现</a>
    </div>
    <div class="result-grid">
      <div class="result-card">
        <div class="metric">30+</div>
        <div class="metric-label">Skill 按入库标准完成标准化入库</div>
      </div>
      <div class="result-card">
        <div class="metric">1000+</div>
        <div class="metric-label">团队内使用次数</div>
      </div>
      <div class="result-card">
        <div class="metric">−20.47%</div>
        <div class="metric-label">典型 Skill 迭代后的 Token 消耗</div>
      </div>
      <div class="result-card">
        <div class="metric">−21.21%</div>
        <div class="metric-label">典型 Skill 迭代后的运行耗时</div>
      </div>
    </div>
  </div>

  <div class="intro-band">
    <p>
      中台设计 Agent 靠一个个 <strong>Skill</strong> 干活：交互流程挖掘、色觉无障碍分析、竞品分析……设计师把自己的方法写成 Skill，Agent 按 Skill 跑完，交出一份 HTML 报告。Skill 越来越多之后，两件事变得很难：<strong>改了一版 Skill，说不清是变好还是变坏</strong>；<strong>同一个 Agent 交出来的报告，每份长得都不一样</strong>。这个项目做的是一套让 Agent 自己变好的框架：先把 Skill 拆开、分层，让每一层都能单独评测，再用评测结果驱动它一轮轮修改自己，只有验证过更好的修改才会被留下。
    </p>
  </div>

  <section>
    <p class="sec-label">Background</p>
    <h2>问题从哪里来？</h2>
    <p>原来的 Skill 是设计师一口气写成的长文档：取数、分析、下结论、排版全在一起，多个流程紧紧缠在一个 Skill 里，从输入一路执行到整份报告，中间没有可以单独检查的环节。</p>
    <div class="fig fig-bg-before" set:html={figBefore}></div>
    <div class="pair">
      <div>
        <h3>难以维护</h3>
        <p>改了一处，只能把整份报告重新看一遍，判断不了效果是好是坏；出了问题，也定位不到是哪个环节造成的。</p>
      </div>
      <div>
        <h3>格式混乱</h3>
        <p>每个 Skill 都顺带决定报告长什么样，字号、颜色、卡片各写各的。同一个 Agent 的输出风格不统一，阅读体验差。</p>
      </div>
    </div>
  </section>

  <section>
    <p class="sec-label">Key Decision</p>
    <h2>拆解与分层</h2>
    <p>关键的一步是把原流程拆成<strong>原子 Skill</strong>，每条线上留出过程检查点和结果；再把「判断」和「呈现」分开：分析判断归 <strong>Skill 层</strong>，呈现归<strong>输出层</strong>，两层之间只传一份 JSON。</p>
    <div class="fig fig-bg-split" set:html={figSplit}></div>
    <div class="pair">
      <div>
        <h3>Skill 层：按检查点逐项判定</h3>
        <p>每个原子 Skill 的过程和结果都能单独检查，改了哪一步、哪一步变好了，都看得出来。</p>
      </div>
      <div>
        <h3>输出层：JSON 冻结，只评呈现</h3>
        <p>内容由 JSON 固定下来，输出层只管怎么排，评测时也只看呈现。排版交给统一的组件库和规范，所有 Skill 的报告长成一种风格。</p>
      </div>
    </div>
    <p style="margin-top:1.5rem;">两层用同一套自迭代方法：冻结一组 benchmark → 跑 → 评测 → 归纳问题 → 修改出候选 → 在没见过的验证用例上把关，更好才升级，否则保留原版。下面两节分别展开。</p>
  </section>

  <section>
    <p class="sec-label">Skill Layer</p>
    <h2>Skill 层：评测与自迭代</h2>
    <p>我搭了 Skill 测试平台，和设计师一起定入库标准：源码质量、Token 消耗、运行效率、执行稳定性，以及每个 Skill 自己的过程检查点和理想结果。评测结果直接驱动一条自迭代流水线。</p>
    <div class="fig fig-skill-flow" set:html={figSkill}></div>
    <p class="img-caption">Skill 层自迭代：每一轮里 Benchmark 冻结，验证用例只在把关时使用</p>

    <div class="dg-list">
      <div class="dg-item">
        <span class="dg-num">01</span>
        <div><h3>执行 Agent</h3><p>按当前版 SKILL.md 跑训练用例，完整轨迹写进轨迹库。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">02</span>
        <div><h3>Judge</h3><p>按 rubric 的检查点逐项打分，给出失败说明和对应的轨迹行号。rubric 初版和设计师共创。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">03</span>
        <div><h3>Maintainer</h3><p>按行号回到轨迹里，对照成功和失败的轨迹归纳根因，写进经验库。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">04</span>
        <div><h3>Reviser</h3><p>根据经验库改出候选版 vN+1。每次修改都留痕，被拒绝的也保留，下一轮不再重复同样的失败。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">05</span>
        <div><h3>验证把关</h3><p>在验证用例上比较候选版和当前版：更好才升级，否则保留 vN。</p></div>
      </div>
    </div>
    <p style="margin-top:1rem;">上线之后，用户遇到的 badcase 经人工归类，补成新的 rubric 和新的用例，进入下一轮 benchmark。这条流水线打通了「评估 → 自动修订 → 入库」的闭环：近 30 个 Skill 完成标准化入库，团队内使用 1000+ 次；典型 Skill 迭代后 Token 消耗下降 20.47%，运行耗时下降 21.21%。</p>
  </section>

  <section>
    <p class="sec-label">Output Layer</p>
    <h2>输出层：规范、评测与自迭代</h2>
    <p>输出层要解决「每份报告都长得不一样」。做法是三件事：给 Agent 一套只能这样用的<strong>规范</strong>，一套能说清好坏的<strong>评测</strong>，再让 Agent 按评测结果<strong>自己改规范</strong>。</p>

    <h3 class="sub-h">规范：组件库 + UI Spec</h3>
    <div class="pair" style="margin-top:0.75rem;">
      <div>
        <h3>组件库（所有 Skill 共用）</h3>
        <p>基于 Radix UI 搭的报告组件库，定好视觉规范和 design token：字号、间距刻度、栅格、颜色都收在组件里。Agent 只能拼组件，不再自己写样式。</p>
      </div>
      <div>
        <h3>UI Spec（每个 Skill 一份）</h3>
        <p>写给 Agent 的输出指南：这个 Skill 的数据该放进哪些节、用哪个组件、怎么排。它只影响这一个 Skill，是自迭代主要修改的对象。</p>
      </div>
    </div>

    <h3 class="sub-h">评测：程序检查 → 审美 Judge</h3>
    <p><strong>程序检查</strong>读渲染后的 DOM 和几何尺寸：有没有绕开组件库、字号和间距是否在刻度上、是否对齐栅格、元素有没有重叠溢出。能用规则判的，都不交给模型。</p>
    <p>全部通过之后才轮到<strong>审美 Judge</strong>。实验发现，让模型给单张页面打分，只能分开好坏差得远的页面，名次接近的两版常常同分（认出第一名只有 31–43%）；而迭代时比较的新旧两版恰恰就是名次接近的。所以改成<strong>两两比较</strong>：把新旧两版并排给它，按 7 条 rubric 逐条先写两版的观察，再判哪版更好，最后给出总的结论和还剩下的问题。同一对页面换个左右顺序再判一次，两次一致才算数，抵消位置偏差。</p>
    <ol class="criteria">
      {criteria.map((c, i) => <li><span class="no">{String(i + 1).padStart(2, '0')}</span>{c}</li>)}
    </ol>
    <p>这 7 条 rubric 是用设计师的人工排序校准出来的：一次只改一条、每改一次都和人的排序对一遍，从 rubric7 一路改到 rubric31。</p>
    <div class="result-grid">
      <div class="result-card">
        <div class="metric">96%</div>
        <div class="metric-sub">测试集 · 248 / 257 对</div>
        <div class="metric-label">两两判断与设计师排序一致</div>
      </div>
      <div class="result-card">
        <div class="metric">93%</div>
        <div class="metric-sub">验证集 · 116 / 125 对</div>
        <div class="metric-label">两两判断与设计师排序一致</div>
      </div>
      <div class="result-card">
        <div class="metric">81%</div>
        <div class="metric-sub">测试集</div>
        <div class="metric-label">认出设计师排的第一名</div>
      </div>
      <div class="result-card">
        <div class="metric">70%</div>
        <div class="metric-sub">验证集</div>
        <div class="metric-label">认出设计师排的第一名</div>
      </div>
    </div>

    <h3 class="sub-h">自迭代：两个迭代对象，两条轨道</h3>
    <p>骨架和 Skill 层一样，不同在于 Maintainer 写出问题清单之后会先<strong>归因</strong>：是布局没排好，还是组件库里根本没有合适的组件。</p>
    <div class="fig fig-output-flow" set:html={figOutput}></div>
    <p class="img-caption">输出层自迭代：布局问题改 UI Spec，组件不够改组件库，两条轨道结构相同</p>
    <div class="pair">
      <div>
        <h3>布局问题 → 改 UI Spec</h3>
        <p>UI Spec Reviser 每次只改一条规则，按新规则重做训练页，再在验证样本上和当前版两两比较：程序检查不能变差，审美 Judge 两种顺序都选新版才采用。</p>
      </div>
      <div>
        <h3>组件不够 → 改组件库</h3>
        <p>组件 Reviser 写出新组件和演示页。组件库影响所有 Skill，所以合并前要人工审批；合并后，每个 Skill 的页面都按新组件重做一遍。</p>
      </div>
    </div>
    <p style="margin-top:1.5rem;">上线后，设计师反馈的 badcase 经人工归类，一部分写成「反馈 rubric」交给审美 Judge，一部分补成新的训练和验证样本。这套机制落地为团队的验收标准，Agent 的 HTML 输出统一成一种风格。</p>
  </section>

  <section id="reproduce">
    <p class="sec-label">Public Reproduction</p>
    <h2>用虚构数据复现一遍</h2>
    <p>实习中的报告和数据不能公开。为了能把输出层讲清楚、拿出过程数据，我在实习结束后用<strong>虚构数据</strong>把输出层的 loop 从头搭了一遍：两个 Skill（交互流程挖掘、色觉无障碍分析），每个 6 份报告，4 份训练、2 份验证；生成 Agent 和审美 Judge 都用 DeepSeek。</p>
    <p class="note">本节的页面、轮次和组件提案都来自这次复现，不是实习中的数据。</p>

    <h3 class="sub-h">一份报告的版本演进</h3>
    <p>用「交互流程挖掘」的同一份报告（外卖下单支付，快送对比小橙），把输出层的几个阶段串起来：从没有组件库，到只用组件库，再到组件迭代和审美迭代。采用的版本连成主线，没采用的候选从它出发的版本分出去。每张截图只截这一版改动的那一节。</p>
    <p class="note">这张图是为讲清过程整理的示意：版本的改动和判定按 loop 的规则编排，截图都由组件库真实渲染；真实运行的轮次记录见下一张表。</p>
    <div class="vtrack-legend" aria-hidden="true">
      <span><i class="lg-main"></i>主线：采用的版本</span>
      <span><i class="lg-branch"></i>分支：没采用的候选</span>
    </div>
    <div class="vtrack">
      {stages.map((st, si) => (
        <Fragment>
          <div class="vstage">
            <div class="vrail"><span class="dot"></span></div>
            <div class="vstage-h">
              <span class="vstage-no">{st.no}</span>
              <span class="vstage-name">{st.name}</span>
              <span class="vstage-who">{st.who}</span>
            </div>
          </div>
          {st.items.map((id, ii) => {
            const v = V[id];
            const last = si === stages.length - 1 && ii === st.items.length - 1;
            const tall = v.img.h > 400;
            return (
              <div class={`vrow${last ? ' last' : ''}`}>
                <div class="vrail"><span class="dot"></span></div>
                <div class="vcard">
                  <div class="vhead"><span class="vno">{id.toUpperCase()}</span>{id !== 'v1' && <span class="vok">采用</span>}</div>
                  <h4>{v.title}</h4>
                  <p>{v.text}</p>
                  {v.facts && <p class="facts">{v.facts}</p>}
                  <div class={`vimg${tall ? ' tall' : ''}`}><img src={v.img.src} width={v.img.w} height={v.img.h} loading="lazy" alt={`${id.toUpperCase()}「${v.title}」改动处截图`} /></div>
                </div>
                {v.branch && (
                  <div class="vcard vbranch">
                    <div class="vhead"><span class="vno">候选</span><span class="vx">未采用 · {v.branch.result}</span></div>
                    <h4>{v.branch.title}</h4>
                    <p>{v.branch.why}</p>
                    <div class={`vimg${v.branch.img.h > 400 ? ' tall' : ''}`}><img src={v.branch.img.src} width={v.branch.img.w} height={v.branch.img.h} loading="lazy" alt={`没采用的候选「${v.branch.title}」截图`} /></div>
                  </div>
                )}
              </div>
            );
          })}
        </Fragment>
      ))}
    </div>

    <h3 class="sub-h">每一轮改了什么</h3>
    <p>「交互流程挖掘」的 13 轮 UI Spec 候选。把关很严：只要在一份验证报告上输了，候选就不采用，所以多数修改被拒。被拒的候选和理由都留在修改记录里，下一轮的 Reviser 会读到它们。</p>
    <div class="table-scroll">
      <table class="rounds">
        <thead><tr><th>轮</th><th>这一轮改的规则</th><th>结果</th></tr></thead>
        <tbody>
          {rounds.map((r) => (
            <tr class={r.result}>
              <td class="n">{String(r.n).padStart(2, '0')}</td>
              <td>{r.what}</td>
              <td class="r">{resultText[r.result]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">交互流程挖掘</div>
        <div class="stat-value">13 轮 · 采用 3</div>
        <div class="stat-sub">未采用 9 · 作废 1</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">色觉无障碍分析</div>
        <div class="stat-value">12 轮 · 采用 3</div>
        <div class="stat-sub">未采用 8 · 作废 1</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">组件库</div>
        <div class="stat-value">8 个提案 · 采用 6</div>
        <div class="stat-sub">截图横排、色觉对照图、细线进度条等</div>
      </div>
    </div>

    <h3 class="sub-h">还没解决的</h3>
    <p>验证样本只有两份，把关的结论容易被一份报告左右；Maintainer 每轮列出的问题清单也没有随着轮数明显变短，「组件不够」类的问题会反复出现，迭代还缺一个明确的终点。</p>

    <div style="margin-top:2.5rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
      <a href="/videos/showreel.mp4" target="_blank" class="btn-link video"><Fragment set:html={icPlay} /> 观看 Showreel</a>
      <a href="/" class="btn-link">← 返回首页</a>
    </div>
  </section>

  <footer>© 2026 屈非塬 · State Key Lab of CAD&amp;CG, ZJU</footer>

</body>
<script>
  const themeDots = document.querySelectorAll('.theme-dot');
  if (themeDots.length) {
    const rootEl = document.documentElement;
    const syncDots = () => themeDots.forEach((d) => d.classList.toggle('active', d.dataset.setTheme === rootEl.getAttribute('data-theme')));
    themeDots.forEach((d) => d.addEventListener('click', () => {
      const t = d.dataset.setTheme;
      rootEl.setAttribute('data-theme', t);
      localStorage.setItem('theme', t);
      window.dispatchEvent(new CustomEvent('themechange', { detail: t }));
      syncDots();
    }));
    syncDots();
  }
</script>
</html>
