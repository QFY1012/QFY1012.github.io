---
import '../styles/tokens.css';
import '../styles/home.css'; // 与主页统一 token
import icDown from 'lucide-static/icons/arrow-down.svg?raw';
// 配图由 figures/internship/ 的脚本生成,node figures/internship/export.mjs 导出成下面这些片段
import figBefore from '../figures/internship/bg-before.html?raw';
import figSplit from '../figures/internship/bg-split.html?raw';
import figSkill from '../figures/internship/skill-flow.html?raw';
import figOutput from '../figures/internship/output-flow.html?raw';

// 公开复现里「交互流程挖掘」这份报告的迭代过程(示意,experiments/ui-loop/demo/flow-loop-demo.src.html):
// 页面都由组件库真实渲染,每轮的候选、Judge 意见和把关结果按 loop 的规则模拟
const rounds = [
  { n: 'k1', what: '组件：新增截图组件，链路明细按步骤横排截图（人工提了 3 次意见，第 4 版合并）', result: 'ok' },
  { n: 'k3', what: '组件：进度条改成 1px 细线，截图滚动条悬停才出现，新增带标签的分组线', result: 'ok' },
  { n: 2, what: '核心指标按数字个数排，4 个一行排满', result: 'ok' },
  { n: 3, what: '下一步改用表格（两种顺序判得相反，没效果）', result: 'no' },
  { n: 4, what: '下一步的列数等于建议条数，右边不再空出一列', result: 'ok' },
  { n: 5, what: '截图下删掉备注（页面缺了 5 项数据，程序检查变差）', result: 'no' },
  { n: 6, what: '截图下固定三行：屏名、内容 · 操作、问题，没有问题写「问题：无」', result: 'ok' },
  { n: 7, what: '结论改成一个大数字（像又一组指标，在验证页上输了）', result: 'no' },
  { n: 8, what: '结论第一句判断用大字，解释换行用正文', result: 'ok' },
  { n: 9, what: '问题表改成编号列表（严重度没法竖着比，没效果）', result: 'no' },
  { n: 10, what: '问题表合成四列：问题、位置、严重度、证据', result: 'ok' },
];
// 这份报告的 9 个版本(public/images/internship/versions/vN.webp,vN-s.webp 是缩略图)。
// box 是这一版改动的那一节在整页截图里的位置(demo/flow-pages/boxes.json,截图宽 1248)。
const versions = [
  { step: '无组件库', what: '模型直接写页面', h: 2743 },
  { step: '用组件库', what: '组件库 + UI Spec 初版，还没有截图组件', h: 2866 },
  { step: '组件 k1', what: '新增截图组件', h: 3681, box: [1365, 1320] },
  { step: '组件 k3', what: '细线进度条、分组线', h: 3587, box: [1056, 1535] },
  { step: '第 2 轮', what: '指标一行排满', h: 3479, box: [672, 84] },
  { step: '第 4 轮', what: '下一步按条数分列', h: 3455, box: [3023, 72] },
  { step: '第 6 轮', what: '截图说明固定三行', h: 3455, box: [1257, 1226] },
  { step: '第 8 轮', what: '结论分主次', h: 3467, box: [408, 84] },
  { step: '第 10 轮', what: '问题表合成四列', h: 3467, box: [2687, 156] },
];
const mark = ({ h, box: [y, bh] }) => `top:${((y - 16) / h * 100).toFixed(2)}%;height:${((bh + 32) / h * 100).toFixed(2)}%`;
const resultText = { ok: '采用', no: '未采用', void: '作废' };

// 审美 Judge 的 7 条 rubric(rubric31)
const criteria = ['留白合适', '分组清楚、有垂直韵律', '容器样式有功能', '字体层级清楚', '色彩统一', '同类组件一致', '网格对齐'];
---
<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>自迭代的中台设计 Agent · 屈非塬</title>
  <!-- 深色模式暂时隐藏：固定浅色，与其他项目页一致 -->
  <script is:inline>document.documentElement.setAttribute('data-theme','light')</script>
  <style>
    /* ── 实习项目页专有样式（字号/颜色全部取自 tokens + home 统一层）── */
    :global(html) { scroll-snap-type: none !important; }
    .hero { padding: 8rem 2.5rem 3rem; max-width: var(--content-w); margin: 0 auto; }
    .hero h1 {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 4.5vw, 3rem);
      font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 1rem;
      text-wrap: balance;
    }
    .hero h1 .highlight { color: var(--accent); }
    .hero .subtitle { font-size: var(--text-body); color: var(--text-dim); margin-bottom: 0.4rem; }
    .hero .authors { font-size: var(--text-meta); color: var(--text-dimmer); margin-bottom: 2rem; letter-spacing: 0.03em; }
    .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .hero .result-grid { margin-top: 2.5rem; }
    .metric { font-variant-numeric: tabular-nums; }

    /* 配图：内嵌 SVG，与页面同底色，不加框 */
    .fig { margin-top: 2rem; }
    .fig + .img-caption { margin-top: 0.75rem; }

    /* 编号步骤 */
    .steps { counter-reset: none; }

    /* 两栏要点（无框） */
    .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 1.5rem; }
    .pair > div { min-width: 0; }
    .pair h3 { margin-bottom: 0.5rem; }
    @media (max-width: 700px) { .pair { grid-template-columns: 1fr; gap: 1.75rem; } }

    /* 小节标题（节内） */
    .sub-h { margin-top: 2.75rem; margin-bottom: 0.75rem; }

    /* 审美 rubric：7 条编号行 */
    .criteria { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.5rem 2rem; margin: 1rem 0 0.5rem; }
    .criteria li { display: flex; gap: 0.6rem; align-items: baseline; font-size: var(--text-body); color: var(--text); padding: 0.45rem 0; border-bottom: 1px solid var(--border); }
    .criteria .no { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--accent); font-variant-numeric: tabular-nums; }

    /* 公开复现的说明条 */
    .note {
      font-size: var(--text-meta); color: var(--text-dim); line-height: 1.8;
      border-left: 2px solid var(--accent); padding-left: 0.75rem; margin: 1rem 0 0;
    }

    /* 9 个版本横排：缩略图顶端对齐，窄屏左右滚动 */
    .vstrip-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 1.75rem; padding-bottom: 0.25rem; }
    .vstrip {
      list-style: none; display: grid; grid-template-columns: repeat(9, minmax(88px, 1fr));
      grid-template-rows: repeat(4, auto); column-gap: 0.6rem;
    }
    .vs { display: grid; grid-row: span 4; grid-template-rows: subgrid; row-gap: 0.25rem; min-width: 0; }
    .vs-no { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--accent); }
    .vs-step { font-size: var(--text-meta); font-weight: 600; color: var(--text); line-height: 1.5; }
    .vs-what { font-size: var(--text-meta); color: var(--text-dim); line-height: 1.5; margin-bottom: 0.35rem; }
    .vs-shot { position: relative; display: block; align-self: start; border: 1px solid var(--border); background: #fff; }
    .vs-shot img { display: block; width: 100%; height: auto; }
    .vs-mark { position: absolute; left: 2%; right: 2%; min-height: 6px; border: 1.5px solid var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
    .vs-shot:hover { border-color: var(--text-dimmer); }

    /* 轮次表 */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-top: 1.25rem; }
    .rounds { width: 100%; border-collapse: collapse; font-size: var(--text-body); }
    .rounds th {
      text-align: left; padding: 0.5rem 0.75rem; color: var(--accent);
      font-size: var(--text-meta); letter-spacing: 0.1em; font-weight: 500;
      border-bottom: 1px solid var(--border);
    }
    .rounds td { padding: 0.55rem 0.75rem; color: var(--text-dim); border-bottom: 1px solid var(--border); vertical-align: top; }
    .rounds tr:last-child td { border-bottom: none; }
    .rounds .n { font-family: var(--font-mono); font-size: var(--text-meta); color: var(--text-dimmer); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .rounds .r { white-space: nowrap; font-size: var(--text-meta); }
    .rounds tr.ok td { color: var(--text); }
    .rounds tr.ok .r { color: var(--accent); font-weight: 700; }
    .rounds tr.void .r { color: var(--text-dimmer); }

    @media (max-width: 600px) { .hero { padding: 6.5rem 1.25rem 2.5rem; } }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="back-link">← 返回首页</a>
    <div class="nav-right">
      <span class="nav-badge">阿里巴巴 · 淘天集团</span>
      <div class="theme-dots" role="group" aria-label="切换明暗主题">
        <button class="theme-dot" type="button" data-set-theme="dark" aria-label="深色主题"></button>
        <button class="theme-dot" type="button" data-set-theme="light" aria-label="浅色主题"></button>
      </div>
    </div>
  </nav>

  <div class="hero">
    <span class="conf-badge">实习项目 · AI 设计工程师 · 2026.06 — 2026.09</span>
    <h1>自迭代的<span class="highlight">中台设计 Agent</span>：<br />框架设计与实践</h1>
    <div class="subtitle">设计 Agent 的 Skill 评测与 UI 输出自进化 · Taobao Design Counselor</div>
    <div class="authors">屈非塬 · 阿里巴巴淘天集团</div>
    <div class="hero-actions">
      <a href="#reproduce" class="btn-link"><Fragment set:html={icDown} /> 公开复现</a>
    </div>
    <div class="result-grid">
      <div class="result-card">
        <div class="metric">30+</div>
        <div class="metric-label">Skill 按入库标准完成标准化入库</div>
      </div>
      <div class="result-card">
        <div class="metric">1000+</div>
        <div class="metric-label">团队内使用次数</div>
      </div>
      <div class="result-card">
        <div class="metric">−20.47%</div>
        <div class="metric-label">典型 Skill 迭代后的 Token 消耗</div>
      </div>
      <div class="result-card">
        <div class="metric">−21.21%</div>
        <div class="metric-label">典型 Skill 迭代后的运行耗时</div>
      </div>
    </div>
  </div>

  <div class="intro-band">
    <p>
      中台设计 Agent 靠一个个 <strong>Skill</strong> 干活：交互流程挖掘、色觉无障碍分析、竞品分析……设计师把自己的方法写成 Skill，Agent 按 Skill 跑完，交出一份 HTML 报告。Skill 越来越多之后，两件事变得很难：<strong>改了一版 Skill，说不清是变好还是变坏</strong>；<strong>同一个 Agent 交出来的报告，每份长得都不一样</strong>。这个项目做的是一套让 Agent 自己变好的框架：先把 Skill 拆开、分层，让每一层都能单独评测，再用评测结果驱动它一轮轮修改自己，只有验证过更好的修改才会被留下。
    </p>
  </div>

  <section>
    <p class="sec-label">Background</p>
    <h2>问题从哪里来？</h2>
    <p>原来的 Skill 是设计师一口气写成的长文档：取数、分析、下结论、排版全在一起，多个流程紧紧缠在一个 Skill 里，从输入一路执行到整份报告，中间没有可以单独检查的环节。</p>
    <div class="fig fig-bg-before" set:html={figBefore}></div>
    <div class="pair">
      <div>
        <h3>难以维护</h3>
        <p>改了一处，只能把整份报告重新看一遍，判断不了效果是好是坏；出了问题，也定位不到是哪个环节造成的。</p>
      </div>
      <div>
        <h3>格式混乱</h3>
        <p>每个 Skill 都顺带决定报告长什么样，字号、颜色、卡片各写各的。同一个 Agent 的输出风格不统一，阅读体验差。</p>
      </div>
    </div>
  </section>

  <section>
    <p class="sec-label">Key Decision</p>
    <h2>拆解与分层</h2>
    <p>关键的一步是把原流程拆成<strong>原子 Skill</strong>，每条线上留出过程检查点和结果；再把「判断」和「呈现」分开：分析判断归 <strong>Skill 层</strong>，呈现归<strong>输出层</strong>，两层之间只传一份 JSON。</p>
    <div class="fig fig-bg-split" set:html={figSplit}></div>
    <div class="pair">
      <div>
        <h3>Skill 层：按检查点逐项判定</h3>
        <p>每个原子 Skill 的过程和结果都能单独检查，改了哪一步、哪一步变好了，都看得出来。</p>
      </div>
      <div>
        <h3>输出层：JSON 冻结，只评呈现</h3>
        <p>内容由 JSON 固定下来，输出层只管怎么排，评测时也只看呈现。排版交给统一的组件库和规范，所有 Skill 的报告长成一种风格。</p>
      </div>
    </div>
    <p style="margin-top:1.5rem;">两层用同一套自迭代方法：冻结一组 benchmark → 跑 → 评测 → 归纳问题 → 修改出候选 → 在没见过的验证用例上把关，更好才升级，否则保留原版。下面两节分别展开。</p>
  </section>

  <section>
    <p class="sec-label">Skill Layer</p>
    <h2>Skill 层：评测与自迭代</h2>
    <p>我搭了 Skill 测试平台，和设计师一起定入库标准：源码质量、Token 消耗、运行效率、执行稳定性，以及每个 Skill 自己的过程检查点和理想结果。评测结果直接驱动一条自迭代流水线。</p>
    <div class="fig fig-skill-flow" set:html={figSkill}></div>
    <p class="img-caption">Skill 层自迭代：每一轮里 Benchmark 冻结，验证用例只在把关时使用</p>

    <div class="dg-list">
      <div class="dg-item">
        <span class="dg-num">01</span>
        <div><h3>执行 Agent</h3><p>按当前版 SKILL.md 跑训练用例，完整轨迹写进轨迹库。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">02</span>
        <div><h3>Judge</h3><p>按 rubric 的检查点逐项打分，给出失败说明和对应的轨迹行号。rubric 初版和设计师共创。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">03</span>
        <div><h3>Maintainer</h3><p>按行号回到轨迹里，对照成功和失败的轨迹归纳根因，写进经验库。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">04</span>
        <div><h3>Reviser</h3><p>根据经验库改出候选版 vN+1。每次修改都留痕，被拒绝的也保留，下一轮不再重复同样的失败。</p></div>
      </div>
      <div class="dg-item">
        <span class="dg-num">05</span>
        <div><h3>验证把关</h3><p>在验证用例上比较候选版和当前版：更好才升级，否则保留 vN。</p></div>
      </div>
    </div>
    <p style="margin-top:1rem;">上线之后，用户遇到的 badcase 经人工归类，补成新的 rubric 和新的用例，进入下一轮 benchmark。这条流水线打通了「评估 → 自动修订 → 入库」的闭环：近 30 个 Skill 完成标准化入库，团队内使用 1000+ 次；典型 Skill 迭代后 Token 消耗下降 20.47%，运行耗时下降 21.21%。</p>
  </section>

  <section>
    <p class="sec-label">Output Layer</p>
    <h2>输出层：规范、评测与自迭代</h2>
    <p>输出层要解决「每份报告都长得不一样」：给 Agent 一套<strong>规范</strong>、一套<strong>评测</strong>，再按评测结果<strong>迭代规范</strong>。</p>

    <h3 class="sub-h">规范：组件库 + UI Spec</h3>
    <div class="pair" style="margin-top:0.75rem;">
      <div>
        <h3>组件库（所有 Skill 共用）</h3>
        <p>基于 Radix UI 搭建，字号、间距、栅格、颜色都收进 design token。Agent 只拼组件，不自己写样式。</p>
      </div>
      <div>
        <h3>UI Spec（每个 Skill 一份）</h3>
        <p>告诉 Agent 这个 Skill 的数据放进哪些节、用哪个组件。自迭代主要改的就是它。</p>
      </div>
    </div>

    <h3 class="sub-h">评测：程序检查 → 审美 Judge</h3>
    <p><strong>程序检查</strong>读渲染后的 DOM：是否绕开组件库、字号间距是否在刻度上、是否对齐栅格、有无重叠溢出。规则能判的不交给模型。</p>
    <p>通过后再交给<strong>审美 Judge</strong>。单页打分分不开相近的两版，而迭代比的正是相近的两版，所以改成<strong>两两比较</strong>：按 7 条 rubric 逐条对比新旧两版，左右换位再判一次，两次一致才算数。</p>
    <ol class="criteria">
      {criteria.map((c, i) => <li><span class="no">{String(i + 1).padStart(2, '0')}</span>{c}</li>)}
    </ol>
    <p>这 7 条 rubric 对照设计师的人工排序逐版校准而来。</p>
    <div class="result-grid">
      <div class="result-card">
        <div class="metric">96%</div>
        <div class="metric-sub">测试集 · 248 / 257 对</div>
        <div class="metric-label">两两判断与设计师排序一致</div>
      </div>
      <div class="result-card">
        <div class="metric">93%</div>
        <div class="metric-sub">验证集 · 116 / 125 对</div>
        <div class="metric-label">两两判断与设计师排序一致</div>
      </div>
      <div class="result-card">
        <div class="metric">81%</div>
        <div class="metric-sub">测试集</div>
        <div class="metric-label">认出设计师排的第一名</div>
      </div>
      <div class="result-card">
        <div class="metric">70%</div>
        <div class="metric-sub">验证集</div>
        <div class="metric-label">认出设计师排的第一名</div>
      </div>
    </div>

    <h3 class="sub-h">自迭代：两个迭代对象，两条轨道</h3>
    <p>骨架和 Skill 层一样，只多一步<strong>归因</strong>：问题出在布局，还是组件库缺组件。</p>
    <div class="fig fig-output-flow" set:html={figOutput}></div>
    <p class="img-caption">输出层自迭代：布局问题改 UI Spec，组件不够改组件库，两条轨道结构相同</p>
    <div class="pair">
      <div>
        <h3>布局问题 → 改 UI Spec</h3>
        <p>每次只改一条规则，在验证样本上和当前版两两比较，程序检查不变差、审美 Judge 两种顺序都选新版才采用。</p>
      </div>
      <div>
        <h3>组件不够 → 改组件库</h3>
        <p>写出新组件和演示页。组件库影响所有 Skill，所以人工审批后才合并。</p>
      </div>
    </div>
    <p style="margin-top:1.5rem;">上线后，设计师反馈的 badcase 经人工归类，补成新的 rubric 和样本。</p>
  </section>

  <section id="reproduce">
    <p class="sec-label">Public Reproduction</p>
    <h2>用虚构数据复现一遍</h2>
    <p>实习中的报告和数据不能公开。为了能把输出层讲清楚、拿出过程数据，我在实习结束后用<strong>虚构数据</strong>把输出层的 loop 从头搭了一遍：两个 Skill（交互流程挖掘、色觉无障碍分析），每个 6 份报告，4 份训练、2 份验证；生成 Agent 和审美 Judge 都用 DeepSeek。下面用「交互流程挖掘」的一份报告示意 loop 怎样一步步改页面：先看这份报告的 9 个版本，再看每一轮改了什么。</p>
    <p class="note">本节是示意：页面都由组件库真实渲染，迭代过程按 loop 的规则模拟，不是实习中的数据。</p>

    <div class="vstrip-scroll" tabindex="0" aria-label="9 个版本的整页缩略图，窄屏可左右滚动">
      <ol class="vstrip">
        {versions.map((v, i) => (
          <li class="vs">
            <span class="vs-no">v{i + 1}</span>
            <span class="vs-step">{v.step}</span>
            <span class="vs-what">{v.what}</span>
            <a class="vs-shot" href={`/images/internship/versions/v${i + 1}.webp`} target="_blank" rel="noopener">
              <img src={`/images/internship/versions/v${i + 1}-s.webp`} width="320" height={Math.round(v.h * 320 / 1248)} loading="lazy" alt={`版本 ${i + 1}（${v.step}）的整页截图：${v.what}`} />
              {v.box && <span class="vs-mark" style={mark(v)}></span>}
            </a>
          </li>
        ))}
      </ol>
    </div>
    <p class="img-caption">橙框是这一版改动的地方，点开缩略图看整页。</p>

    <h3 class="sub-h">每一轮改了什么</h3>
    <p>先由组件 Reviser 补组件、人工审批，再由 UI Spec Reviser 每轮改一条规则。把关很严：只要在一份验证报告上输了，或者程序检查变差，候选就不采用。被拒的候选和理由都留在修改记录里，下一轮的 Reviser 会读到它们。</p>
    <div class="table-scroll">
      <table class="rounds">
        <thead><tr><th>轮</th><th>这一轮改的规则</th><th>结果</th></tr></thead>
        <tbody>
          {rounds.map((r) => (
            <tr class={r.result}>
              <td class="n">{String(r.n).padStart(2, '0')}</td>
              <td>{r.what}</td>
              <td class="r">{resultText[r.result]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">UI Spec</div>
        <div class="stat-value">9 轮 · 采用 5</div>
        <div class="stat-sub">没效果 2 · 失败 2</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">组件库</div>
        <div class="stat-value">5 个提案 · 采用 2</div>
        <div class="stat-sub">未采用 1 · 待审批 2</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">审美问题清单</div>
        <div class="stat-value">8 → 0</div>
        <div class="stat-sub">训练页上没有两种顺序都认可的问题，loop 停止</div>
      </div>
    </div>

    <h3 class="sub-h">还没解决的</h3>
    <p>验证样本只有两份，把关的结论容易被一份报告左右；用真实模型跑时，Maintainer 的问题清单并不会像示意里这样一路缩到 0，「组件不够」类的问题会反复出现，迭代还缺一个明确的终点。</p>

    <div style="margin-top:2.5rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
      <a href="/" class="btn-link">← 返回首页</a>
    </div>
  </section>

  <footer>© 2026 屈非塬 · State Key Lab of CAD&amp;CG, ZJU</footer>

</body>
<script>
  const themeDots = document.querySelectorAll('.theme-dot');
  if (themeDots.length) {
    const rootEl = document.documentElement;
    const syncDots = () => themeDots.forEach((d) => d.classList.toggle('active', d.dataset.setTheme === rootEl.getAttribute('data-theme')));
    themeDots.forEach((d) => d.addEventListener('click', () => {
      const t = d.dataset.setTheme;
      rootEl.setAttribute('data-theme', t);
      localStorage.setItem('theme', t);
      window.dispatchEvent(new CustomEvent('themechange', { detail: t }));
      syncDots();
    }));
    syncDots();
  }
</script>
</html>
