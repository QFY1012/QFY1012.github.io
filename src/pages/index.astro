<script>
  // 打字机：角色词循环
  const tags = ['HCI Researcher', 'Designer', 'Developer', 'Agent Builder'];
  const tagEl = document.getElementById('logo-tag');
  if (tagEl) {
    let ti = 0, ci = 0, deleting = false;
    function typeTag() {
      const word = tags[ti];
      if (!deleting) {
        tagEl!.textContent = word.slice(0, ++ci);
        if (ci === word.length) { deleting = true; setTimeout(typeTag, 1800); return; }
        setTimeout(typeTag, 75);
      } else {
        tagEl!.textContent = word.slice(0, --ci);
        if (ci === 0) { deleting = false; ti = (ti + 1) % tags.length; setTimeout(typeTag, 300); return; }
        setTimeout(typeTag, 38);
      }
    }
    setTimeout(typeTag, 800);
  }

  // 导航：滚出首屏时从顶部滑入，回到首屏收起
  const navEl = document.querySelector('nav');
  const heroEl = document.querySelector('.hero');
  if (navEl && heroEl) {
    new IntersectionObserver(([entry]) => {
      navEl.classList.toggle('is-visible', !entry.isIntersecting);
    }, { threshold: 0 }).observe(heroEl);
  }

  // 项目卡整卡点击跳转
  document.querySelectorAll('.project-card.clickable').forEach(card => {
    card.addEventListener('click', e => {
      if (!(e.target as HTMLElement).closest('a') && !window.getSelection().toString()) {
        window.location.href = (card as HTMLElement).dataset.href ?? '';
      }
    });
  });
</script>
<script>
  // 首屏莫比乌斯景深点染（动态加载，不进首屏关键路径）
  const canvas = document.getElementById('hero-ascii') as HTMLCanvasElement | null;
  if (canvas) {
    const m = await import('../scripts/hero-particles');
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      await m.renderStaticFrame(canvas);
    } else {
      await m.initHeroScene(canvas);
    }
  }
</script>
